<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="RELAIS · CLAVIER ET SOURIS"
        android:textColor="#173B35"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Relais inactif"
        android:textColor="#111"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="Connexion Bluetooth"
        android:textColor="#173B35"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button android:id="@+id/btnActivate" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="1. Activer" />
        <Button android:id="@+id/btnVisible" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="2. Visible" />
        <Button android:id="@+id/btnPc" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="3. Mon PC" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="Mode Wi-Fi : entre l’IP et le code affichés sur le PC"
        android:textColor="#173B35"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnMode" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.3" android:text="Mode : Bluetooth" />
        <EditText android:id="@+id/ipField" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.5" android:hint="IP du PC" android:inputType="phone"
            android:digits="0123456789." android:maxLines="1" android:textSize="14sp" />
        <EditText android:id="@+id/pinField" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.8" android:hint="Code" android:inputType="number"
            android:text="1234" android:maxLines="1" android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Pavé tactile · glisse pour déplacer, tape pour cliquer"
        android:textColor="#173B35" />

    <View
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:minHeight="100dp"
        android:background="#DDE1E8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">

        <Button android:id="@+id/btnLeft" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="Clic gauche" />
        <Button android:id="@+id/btnRight" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="Clic droit" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">

        <Button android:id="@+id/keyUp" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="Z" />
        <Button android:id="@+id/keyLeft" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="Q" />
        <Button android:id="@+id/keyDown" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="S" />
        <Button android:id="@+id/keyRight" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="D" />
        <Button android:id="@+id/keySpace" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.5" android:text="Espace" />
    </LinearLayout>
</LinearLayout>
